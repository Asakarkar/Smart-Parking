          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('bookingId', pm.response.json().id); }"
                ]
              }
            }
          ]
